# Server-only URL of the existing NestJS VITO API.
# Local default when omitted in development: http://127.0.0.1:3000
VITO_API_BASE_URL=http://127.0.0.1:3000

# VITO Control Center interactive private owner (server-side only).
# Both IDs are the UUIDs of the existing, currently verified VITO backend
# account and its organization; NOT email addresses or LA VOLPE ID subjects.
# Without BOTH exact values the isolated candidate denies every interactive
# cockpit login (fail closed). Never commit real personal IDs or tokens.
# Required ONLY after private staging acceptance and prior to any deployment.
VITO_CONTROL_OWNER_USER_ID=
VITO_CONTROL_OWNER_ORGANIZATION_ID=
