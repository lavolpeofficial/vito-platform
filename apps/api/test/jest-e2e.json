{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "./tsconfig.spec.json" }]
  },
  "moduleNameMapper": {
    "^(\\.\\.?/.*)\\.js$": "$1",
    "^@vito/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
  }
}
