generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkforceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DepartmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TeamStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrganizationRoleStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum PositionStatus {
  DRAFT
  OPEN
  OCCUPIED
  VACANT
  ARCHIVED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum DigitalEmployeeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EmployeeType {
  ORCHESTRATOR
  SPECIALIST
  ASSISTANT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActorType {
  USER
  DIGITAL_EMPLOYEE
  SYSTEM
}

enum SourceType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  IMAGE
  AUDIO
  VIDEO
  EMAIL
  WEB_CAPTURE
  DATASET
  OTHER
}

enum SourceConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum SourceRightsStatus {
  OWNED
  LICENSED
  CUSTOMER_PROVIDED
  THIRD_PARTY_REFERENCE
  UNKNOWN
}

enum SourceIngestionStatus {
  RECEIVED
  HASHED
  STORED
  FAILED
  QUARANTINED
}

enum SourceExtractionStatus {
  NOT_STARTED
  PROCESSING
  EXTRACTED
  PARTIAL
  FAILED
  NOT_REQUIRED
}

enum SourceValidationStatus {
  UNREVIEWED
  REVIEWED
  VALIDATED
  REJECTED
  SUPERSEDED
}

enum SourceLocatorType {
  PAGE
  SHEET
  CELL_RANGE
  SLIDE
  TIMECODE
  SECTION
  MESSAGE
  OTHER
}

enum SourceDerivationType {
  QUOTE
  PARAPHRASE
  EXTRACTION
  INFERENCE
  SYNTHESIS
}

enum WorkflowRunStatus {
  CREATED
  RUNNING
  WAITING_FOR_HUMAN
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  READY
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum EngineeringStepType {
  PLAN
  BUILD
  TEST
  PACKAGE
  RED_TEAM
  PARSE_VERDICT
  CORRECTION
  VERIFY
  HUMAN_RELEASE_GATE
  RELEASE_EXECUTION
  REMOTE_VERIFY
}

enum ProviderStatus {
  ACTIVE
  DISABLED
  DEGRADED
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  QUOTA_LIMITED
  UNAVAILABLE
  DISABLED
}

enum ProviderQuotaStatus {
  UNKNOWN
  AVAILABLE
  LIMITED
  EXHAUSTED
}

enum ProviderType {
  CLOUD_LLM
  LOCAL_LLM
  DETERMINISTIC_TOOL
  LOCAL_TOOL
}

/// Credential requirement state of a provider (EO-01.5).
/// UNKNOWN must fail closed for productive invocation; missing data is
/// never silently mapped to NOT_REQUIRED.
enum ProviderCredentialRequirement {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

/// Interner Claim-State der Governed-Idempotenz-Grenze (EO-01.5 Phase 3H.1).
/// Kein zweiter Lifecycle-Motor: Claims werden NIE freigegeben.
enum GovernedInvocationClaimState {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT_UNKNOWN
  FAILED_UNKNOWN
}

/// Status einer intern initiierten governed Operation (B2a).
enum GovernedOperationEnvelopeStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Ausführungsstatus einer einzelnen Provider-Ausführung (Spiegel des
/// EO-Contracts AgentExecutionStatus).
enum AgentExecutionStatus {
  QUEUED
  STARTING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
  POLICY_BLOCKED
  QUOTA_BLOCKED
}

enum OperatorTaskStatus {
  DISPATCHING
  COMPLETED
  HUMAN_GATE
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users                      User[]
  workforceInstances         WorkforceInstance[]
  departments                Department[]
  teams                      Team[]
  organizationRoles          OrganizationRole[]
  positions                  Position[]
  digitalEmployees           DigitalEmployee[]
  capabilities               Capability[]
  tasks                      Task[]
  auditEvents                AuditEvent[]
  sources                    Source[]
  knowledgeSourceLinks       KnowledgeSourceLink[]
  workflowRuns               WorkflowRun[]
  workflowStepRuns           WorkflowStepRun[]
  agentProviders             AgentProvider[]
  providerRoutingDecisions   ProviderRoutingDecision[]
  providerCapabilities       ProviderCapability[]
  governedOperationEnvelopes GovernedOperationEnvelope[]
  governedExecutionRecords   GovernedExecutionRecord[]
  operatorTasks              OperatorTask[]

  @@map("organizations")
}

model WorkforceInstance {
  id                     String          @id @default(uuid())
  organizationId         String
  code                   String
  name                   String
  description            String?
  status                 WorkforceStatus @default(DRAFT)
  isDefault              Boolean         @default(false)
  orchestratorEmployeeId String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  orchestrator DigitalEmployee?  @relation("WorkforceOrchestrator", fields: [orchestratorEmployeeId], references: [id], onDelete: SetNull)
  members      DigitalEmployee[] @relation("WorkforceMembers")
  departments Department[]
  teams       Team[]
  positions   Position[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([orchestratorEmployeeId])
  @@map("workforce_instances")
}

model Department {
  id                  String           @id @default(uuid())
  organizationId      String
  workforceInstanceId String
  parentDepartmentId  String?
  managerEmployeeId   String?
  code                String
  name                String
  description         String?
  status              DepartmentStatus @default(DRAFT)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  workforceInstance WorkforceInstance @relation(fields: [workforceInstanceId], references: [id], onDelete: Cascade)
  parentDepartment  Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments  Department[]      @relation("DepartmentHierarchy")
  manager           DigitalEmployee?  @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  teams             Team[]
  positions         Position[]

  @@unique([workforceInstanceId, code])
  @@index([organizationId])
  @@index([workforceInstanceId])
  @@index([parentDepartmentId])
  @@index([managerEmployeeId])
  @@map("departments")
}

model Team {
  id                  String     @id @default(uuid())
  organizationId      String
  workforceInstanceId String
  departmentId        String
  managerEmployeeId   String?
  code                String
  name                String
  description         String?
  status              TeamStatus @default(DRAFT)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  workforceInstance WorkforceInstance @relation(fields: [workforceInstanceId], references: [id], onDelete: Cascade)
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  manager           DigitalEmployee?  @relation("TeamManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  positions         Position[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@index([workforceInstanceId])
  @@index([departmentId])
  @@index([managerEmployeeId])
  @@map("teams")
}

model OrganizationRole {
  id               String                 @id @default(uuid())
  organizationId   String
  code             String
  name             String
  description      String?
  status           OrganizationRoleStatus @default(DRAFT)
  responsibilities Json                   @default("[]")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  positions    Position[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("organization_roles")
}

model Position {
  id                   String         @id @default(uuid())
  organizationId       String
  workforceInstanceId  String
  departmentId         String?
  teamId               String?
  organizationRoleId   String
  managerPositionId    String?
  occupantEmployeeId   String?        @unique
  code                 String
  title                String
  description          String?
  status               PositionStatus @default(DRAFT)
  isLeadership         Boolean        @default(false)
  budgetResponsibility Decimal?       @db.Decimal(18, 2)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  workforceInstance WorkforceInstance @relation(fields: [workforceInstanceId], references: [id], onDelete: Cascade)
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organizationRole  OrganizationRole  @relation(fields: [organizationRoleId], references: [id])
  managerPosition   Position?         @relation("PositionHierarchy", fields: [managerPositionId], references: [id], onDelete: SetNull)
  directReports     Position[]        @relation("PositionHierarchy")
  occupant          DigitalEmployee?  @relation("PositionOccupant", fields: [occupantEmployeeId], references: [id], onDelete: SetNull)

  @@unique([workforceInstanceId, code])
  @@index([organizationId])
  @@index([workforceInstanceId])
  @@index([departmentId])
  @@index([teamId])
  @@index([organizationRoleId])
  @@index([managerPositionId])
  @@map("positions")
}

model User {
  id                String     @id @default(uuid())
  organizationId    String
  email             String
  firstName         String
  lastName          String
  role              UserRole   @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  passwordHash      String?
  lastLoginAt       DateTime?
  tokenVersion      Int        @default(1)
  isMachineIdentity Boolean    @default(false)
  machineScope      String?
  deletedAt         DateTime?
  deletedByUserId   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  deletedByUser User?  @relation("UserDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  disabledUsers User[] @relation("UserDeletedBy")

  assignedTasks Task[] @relation("TaskAssignedUser")
  createdTasks  Task[] @relation("TaskCreatedByUser")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([deletedByUserId])
  @@map("users")
}

model DigitalEmployee {
  id                  String                @id @default(uuid())
  organizationId      String
  workforceInstanceId String?
  name                String
  code                String
  description         String?
  status              DigitalEmployeeStatus @default(DRAFT)
  employeeType        EmployeeType
  version             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization           Organization                @relation(fields: [organizationId], references: [id])
  workforceInstance      WorkforceInstance?          @relation("WorkforceMembers", fields: [workforceInstanceId], references: [id], onDelete: SetNull)
  orchestratedWorkforces WorkforceInstance[]         @relation("WorkforceOrchestrator")
  managedDepartments     Department[]                @relation("DepartmentManager")
  managedTeams           Team[]                      @relation("TeamManager")
  position               Position?                   @relation("PositionOccupant")
  capabilities           DigitalEmployeeCapability[]
  assignedTasks          Task[]                      @relation("TaskAssignedDigitalEmployee")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([workforceInstanceId])
  @@map("digital_employees")
}

model Capability {
  id               String    @id @default(uuid())
  organizationId   String
  code             String
  name             String
  description      String?
  riskLevel        RiskLevel @default(LOW)
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization                @relation(fields: [organizationId], references: [id])
  digitalEmployees DigitalEmployeeCapability[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("capabilities")
}

model DigitalEmployeeCapability {
  digitalEmployeeId String
  capabilityId      String
  isEnabled         Boolean  @default(true)
  configuration     Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id])
  capability      Capability      @relation(fields: [capabilityId], references: [id])

  @@id([digitalEmployeeId, capabilityId])
  @@map("digital_employee_capabilities")
}

model Task {
  id                        String       @id @default(uuid())
  organizationId            String
  title                     String
  description               String?
  status                    TaskStatus   @default(OPEN)
  priority                  TaskPriority @default(NORMAL)
  assignedUserId            String?
  assignedDigitalEmployeeId String?
  dueAt                     DateTime?
  createdByUserId           String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  completedAt               DateTime?

  organization            Organization     @relation(fields: [organizationId], references: [id])
  assignedUser            User?            @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  assignedDigitalEmployee DigitalEmployee? @relation("TaskAssignedDigitalEmployee", fields: [assignedDigitalEmployeeId], references: [id])
  createdByUser           User?            @relation("TaskCreatedByUser", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("tasks")
}

model OperatorTask {
  id                 String             @id @default(uuid())
  organizationId     String
  userId             String
  requestId          String
  requestFingerprint String
  correlationId      String
  workflowRunId      String
  workflowStepRunId  String
  capabilityCode     String
  prompt             String?            @db.Text
  assuranceLevel     String?
  status             OperatorTaskStatus

  maxDurationMs     Int?
  maxTokens         Int?
  maxCostMinorUnits Int?

  invocationId         String?
  executionId          String?
  routingDecisionId    String?
  providerCode         String?
  providerName         String?
  stdout               String?  @db.Text
  stderr               String?  @db.Text
  changedFiles         Json?
  patch                String?  @db.Text
  errorReason          String?
  errorMessage         String?
  errorRetryable       Boolean?
  reviewRequired       Boolean  @default(false)
  workspaceDisposition String?

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  sensitivePayloadAvailable Boolean   @default(true)
  sensitivePayloadExpiresAt DateTime
  sensitivePayloadDeletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestId])
  @@index([organizationId, status])
  @@index([organizationId, correlationId])
  @@index([sensitivePayloadAvailable, sensitivePayloadExpiresAt])
  @@map("operator_tasks")
}

model AuditEvent {
  id             String    @id @default(uuid())
  organizationId String
  actorType      ActorType
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

model Source {
  id                 String                 @id @default(uuid())
  sourceId           String                 @unique
  organizationId     String
  projectKey         String?
  domain             String?
  sourceType         SourceType
  originalFilename   String
  mimeType           String
  byteSize           BigInt
  sha256             String
  storageUri         String
  version            Int                    @default(1)
  supersedesSourceId String?
  parentSourceId     String?
  language           String?
  title              String?
  author             String?
  sourceDate         DateTime?
  ingestedAt         DateTime               @default(now())
  ingestedBy         String
  confidentiality    SourceConfidentiality  @default(INTERNAL)
  rightsStatus       SourceRightsStatus     @default(UNKNOWN)
  retentionClass     String?
  ingestionStatus    SourceIngestionStatus  @default(RECEIVED)
  extractionStatus   SourceExtractionStatus @default(NOT_STARTED)
  validationStatus   SourceValidationStatus @default(UNREVIEWED)
  metadata           Json                   @default("{}")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id])
  supersedes     Source?               @relation("SourceVersion", fields: [supersedesSourceId], references: [id], onDelete: SetNull)
  supersededBy   Source[]              @relation("SourceVersion")
  parent         Source?               @relation("SourceParent", fields: [parentSourceId], references: [id], onDelete: SetNull)
  children       Source[]              @relation("SourceParent")
  knowledgeLinks KnowledgeSourceLink[]

  @@unique([organizationId, sha256])
  @@index([organizationId])
  @@index([organizationId, projectKey])
  @@index([organizationId, originalFilename])
  @@index([supersedesSourceId])
  @@index([parentSourceId])
  @@map("sources")
}

model KnowledgeSourceLink {
  id             String               @id @default(uuid())
  organizationId String
  sourceId       String
  knowledgeRef   String
  locatorType    SourceLocatorType?
  locatorValue   String?
  derivationType SourceDerivationType
  confidence     Float?
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceId])
  @@index([organizationId, knowledgeRef])
  @@map("knowledge_source_links")
}

model WorkflowRun {
  id                        String               @id @default(uuid())
  organizationId            String
  taskId                    String?
  workflowDefinitionCode    String
  workflowDefinitionVersion String
  assuranceLevel            String
  status                    WorkflowRunStatus    @default(CREATED)
  currentStepType           EngineeringStepType?
  correctionLoopCount       Int                  @default(0)
  maxCorrectionLoops        Int                  @default(3)
  correlationId             String
  blockReasonCode           String?
  failureReasonCode         String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  startedAt                 DateTime?
  completedAt               DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  stepRuns     WorkflowStepRun[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, correlationId])
  @@index([correlationId])
  @@map("workflow_runs")
}

model WorkflowStepRun {
  id             String              @id @default(uuid())
  organizationId String
  workflowRunId  String
  stepType       EngineeringStepType
  status         WorkflowStepStatus  @default(PENDING)
  attemptNumber  Int                 @default(1)
  causationId    String?
  metadata       Json                @default("{}")
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowRunId])
  @@index([organizationId, workflowRunId])
  @@map("workflow_step_runs")
}

model AgentProvider {
  id                      String                        @id @default(uuid())
  organizationId          String
  providerCode            String
  displayName             String
  providerType            ProviderType                  @default(CLOUD_LLM)
  status                  ProviderStatus                @default(ACTIVE)
  credentialRequirement   ProviderCredentialRequirement @default(UNKNOWN)
  modelFamily             String?
  modelName               String?
  modelCode               String?
  supportedCapabilities   Json                          @default("[]")
  estimatedCostMinorUnits Int?
  healthStatus            ProviderHealthStatus          @default(UNKNOWN)
  healthCheckedAt         DateTime?
  quotaStatus             ProviderQuotaStatus           @default(UNKNOWN)
  quotaCheckedAt          DateTime?
  qualityScore            Float?
  latencyScore            Float?
  costScore               Float?
  costMetadata            Json                          @default("{}")
  assuranceLevels         Json                          @default("[]")
  metadata                Json                          @default("{}")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id])
  routingDecisions ProviderRoutingDecision[]
  capabilities     ProviderCapability[]

  @@unique([organizationId, providerCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, providerCode])
  @@map("agent_providers")
}

/// Durable Capability-Zuweisung: verknüpft einen AgentProvider mit einem
/// EngineeringCapability-Code. Nur ENABLED Assignments berechtigen zum Routing.
/// Das legacy JSON `supportedCapabilities` ist KEINE Routing-Authorität mehr.
model ProviderCapability {
  id              String   @id @default(uuid())
  organizationId  String
  agentProviderId String
  capabilityCode  String
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  agentProvider AgentProvider @relation(fields: [agentProviderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentProviderId, capabilityCode])
  @@index([organizationId])
  @@index([organizationId, capabilityCode])
  @@index([organizationId, capabilityCode, isEnabled])
  @@map("provider_capabilities")
}

model ProviderRoutingDecision {
  id                   String   @id @default(uuid())
  organizationId       String
  correlationId        String
  workflowRunId        String?
  workflowStepRunId    String?
  requestedCapability  String
  assuranceLevel       String?
  selectedProviderId   String?
  candidateProviderIds Json     @default("[]")
  rejectionReasons     Json     @default("{}")
  scoreComponents      Json     @default("{}")
  finalScore           Float?
  decisionReason       String
  routingPolicyVersion String?
  createdAt            DateTime @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id])
  selectedProvider AgentProvider? @relation(fields: [selectedProviderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, correlationId])
  @@index([organizationId, workflowRunId])
  @@index([selectedProviderId])
  @@map("provider_routing_decisions")
}

/// Intern initiierte governed Operation (B2a): liefert die vertrauenswürdige
/// workflowRunId-Identität für Aufrufe der eingefrorenen EO-01.5
/// GovernedInvocationService-Schnittstelle, ohne Engineering-Workflow-Tabellen
/// zu überfrachten. Kein Task-Dispatch, keine Human-Gate-Persistenz.
model GovernedOperationEnvelope {
  id             String                          @id @default(uuid())
  organizationId String
  purposeCode    String
  correlationId  String?
  status         GovernedOperationEnvelopeStatus @default(PENDING)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  executions   GovernedExecutionRecord[]

  @@index([organizationId])
  @@index([correlationId])
  @@map("governed_operation_envelopes")
}

/// Claim-Eintrag der Governed-Idempotenz-Grenze (EO-01.5 Phase 3H.1).
///
/// Dedup-Primärschlüssel ist die LOGISCHE OPERATION (logicalOperationKey),
/// trusted abgeleitet und inklusive organizationId-Feld (length-präfixierte
/// Kodierung) — ein fremder Tenant kann keinen kollidierenden Schlüssel
/// erzeugen. Die Attempt-Identität (invocationId) ist ebenfalls UNIQUE:
/// dieselbe invocationId unter einem anderen logischen Schlüssel ist
/// CONTEXT_CONFLICT. Bewusst OHNE eigenes organizationId-Feld: die
/// eingefrorene Store-Schnittstelle führt keine Tenant-ID; die Tenant-
/// Bindung steckt unveränderlich im Schlüssel selbst.
/// Claims werden NIE freigegeben (kein Release-Pfad).
model GovernedInvocationClaim {
  id                  String                        @id @default(uuid())
  logicalOperationKey String                        @unique
  invocationId        String                        @unique
  contextFingerprint  String
  state               GovernedInvocationClaimState @default(IN_PROGRESS)
  claimedAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@map("governed_invocation_claims")
}

/// Persistiertes Ergebnis einer governed Invocation (Evidence Ledger).
/// Alle JSON-Strukturen sind bereits durch EO-01.5 sanitisierte Formen —
/// dieser Datensatz speichert KEINE Rohinhalte, Secrets oder Umgebungen.
model GovernedExecutionRecord {
  id                      String               @id
  envelopeId              String
  organizationId          String
  workflowRunId           String
  workflowStepRunId       String
  capabilityCode          String
  providerId              String
  status                  AgentExecutionStatus
  startedAt               DateTime
  completedAt             DateTime?
  durationMs              Int?
  outputReference         String?
  artifactReferences      Json?
  normalizedError         Json?
  policyDecisionReference String
  sideEffectSummary       Json?
  usageMetadata           Json?
  createdAt               DateTime             @default(now())

  envelope     GovernedOperationEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([envelopeId])
  @@index([organizationId, workflowRunId])
  @@map("governed_execution_records")
}
