generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum DigitalEmployeeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EmployeeType {
  ORCHESTRATOR
  SPECIALIST
  ASSISTANT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActorType {
  USER
  DIGITAL_EMPLOYEE
  SYSTEM
}

enum SourceType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  IMAGE
  AUDIO
  VIDEO
  EMAIL
  WEB_CAPTURE
  DATASET
  OTHER
}

enum SourceConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum SourceRightsStatus {
  OWNED
  LICENSED
  CUSTOMER_PROVIDED
  THIRD_PARTY_REFERENCE
  UNKNOWN
}

enum SourceIngestionStatus {
  RECEIVED
  HASHED
  STORED
  FAILED
  QUARANTINED
}

enum SourceExtractionStatus {
  NOT_STARTED
  PROCESSING
  EXTRACTED
  PARTIAL
  FAILED
  NOT_REQUIRED
}

enum SourceValidationStatus {
  UNREVIEWED
  REVIEWED
  VALIDATED
  REJECTED
  SUPERSEDED
}

enum SourceLocatorType {
  PAGE
  SHEET
  CELL_RANGE
  SLIDE
  TIMECODE
  SECTION
  MESSAGE
  OTHER
}

enum SourceDerivationType {
  QUOTE
  PARAPHRASE
  EXTRACTION
  INFERENCE
  SYNTHESIS
}

enum WorkflowRunStatus {
  CREATED
  RUNNING
  WAITING_FOR_HUMAN
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  READY
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum EngineeringStepType {
  PLAN
  BUILD
  TEST
  PACKAGE
  RED_TEAM
  PARSE_VERDICT
  CORRECTION
  VERIFY
  HUMAN_RELEASE_GATE
  RELEASE_EXECUTION
  REMOTE_VERIFY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users                User[]
  digitalEmployees     DigitalEmployee[]
  capabilities         Capability[]
  tasks                Task[]
  auditEvents          AuditEvent[]
  sources              Source[]
  knowledgeSourceLinks KnowledgeSourceLink[]
  workflowRuns         WorkflowRun[]
  workflowStepRuns     WorkflowStepRun[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid())
  organizationId  String
  email           String
  firstName       String
  lastName        String
  role            UserRole   @default(MEMBER)
  status          UserStatus @default(ACTIVE)
  passwordHash    String?
  lastLoginAt     DateTime?
  tokenVersion    Int        @default(1)
  deletedAt       DateTime?
  deletedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  deletedByUser User?  @relation("UserDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  disabledUsers User[] @relation("UserDeletedBy")

  assignedTasks Task[] @relation("TaskAssignedUser")
  createdTasks  Task[] @relation("TaskCreatedByUser")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([deletedByUserId])
  @@map("users")
}

model DigitalEmployee {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  status         DigitalEmployeeStatus @default(DRAFT)
  employeeType   EmployeeType
  version        String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id])
  capabilities DigitalEmployeeCapability[]
  assignedTasks Task[]                       @relation("TaskAssignedDigitalEmployee")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("digital_employees")
}

model Capability {
  id               String    @id @default(uuid())
  organizationId   String
  code             String
  name             String
  description      String?
  riskLevel        RiskLevel @default(LOW)
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization                @relation(fields: [organizationId], references: [id])
  digitalEmployees DigitalEmployeeCapability[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("capabilities")
}

model DigitalEmployeeCapability {
  digitalEmployeeId String
  capabilityId      String
  isEnabled         Boolean  @default(true)
  configuration     Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id])
  capability      Capability      @relation(fields: [capabilityId], references: [id])

  @@id([digitalEmployeeId, capabilityId])
  @@map("digital_employee_capabilities")
}

model Task {
  id                        String       @id @default(uuid())
  organizationId            String
  title                     String
  description               String?
  status                    TaskStatus   @default(OPEN)
  priority                  TaskPriority @default(NORMAL)
  assignedUserId            String?
  assignedDigitalEmployeeId String?
  dueAt                     DateTime?
  createdByUserId           String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  completedAt               DateTime?

  organization           Organization     @relation(fields: [organizationId], references: [id])
  assignedUser            User?            @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  assignedDigitalEmployee DigitalEmployee? @relation("TaskAssignedDigitalEmployee", fields: [assignedDigitalEmployeeId], references: [id])
  createdByUser            User?           @relation("TaskCreatedByUser", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("tasks")
}

model AuditEvent {
  id             String    @id @default(uuid())
  organizationId String
  actorType      ActorType
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

model Source {
  id                String                   @id @default(uuid())
  sourceId          String                   @unique
  organizationId    String
  projectKey        String?
  domain            String?
  sourceType        SourceType
  originalFilename  String
  mimeType          String
  byteSize          BigInt
  sha256            String
  storageUri        String
  version           Int                      @default(1)
  supersedesSourceId String?
  parentSourceId    String?
  language          String?
  title             String?
  author            String?
  sourceDate        DateTime?
  ingestedAt        DateTime                 @default(now())
  ingestedBy        String
  confidentiality   SourceConfidentiality    @default(INTERNAL)
  rightsStatus      SourceRightsStatus       @default(UNKNOWN)
  retentionClass    String?
  ingestionStatus   SourceIngestionStatus    @default(RECEIVED)
  extractionStatus  SourceExtractionStatus   @default(NOT_STARTED)
  validationStatus  SourceValidationStatus   @default(UNREVIEWED)
  metadata          Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id])
  supersedes        Source?                  @relation("SourceVersion", fields: [supersedesSourceId], references: [id], onDelete: SetNull)
  supersededBy      Source[]                 @relation("SourceVersion")
  parent            Source?                  @relation("SourceParent", fields: [parentSourceId], references: [id], onDelete: SetNull)
  children          Source[]                 @relation("SourceParent")
  knowledgeLinks    KnowledgeSourceLink[]

  @@unique([organizationId, sha256])
  @@index([organizationId])
  @@index([organizationId, projectKey])
  @@index([organizationId, originalFilename])
  @@index([supersedesSourceId])
  @@index([parentSourceId])
  @@map("sources")
}

model KnowledgeSourceLink {
  id             String               @id @default(uuid())
  organizationId String
  sourceId       String
  knowledgeRef   String
  locatorType    SourceLocatorType?
  locatorValue   String?
  derivationType SourceDerivationType
  confidence     Float?
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceId])
  @@index([organizationId, knowledgeRef])
  @@map("knowledge_source_links")
}

model WorkflowRun {
  id                        String             @id @default(uuid())
  organizationId            String
  taskId                    String?
  workflowDefinitionCode    String
  workflowDefinitionVersion String
  assuranceLevel            String
  status                    WorkflowRunStatus  @default(CREATED)
  currentStepType           EngineeringStepType?
  correctionLoopCount       Int                @default(0)
  maxCorrectionLoops        Int                @default(3)
  correlationId             String
  blockReasonCode           String?
  failureReasonCode         String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  startedAt                 DateTime?
  completedAt               DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  stepRuns     WorkflowStepRun[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, correlationId])
  @@index([correlationId])
  @@map("workflow_runs")
}

model WorkflowStepRun {
  id             String             @id @default(uuid())
  organizationId String
  workflowRunId  String
  stepType       EngineeringStepType
  status         WorkflowStepStatus @default(PENDING)
  attemptNumber  Int                @default(1)
  causationId    String?
  metadata       Json               @default("{}")
  startedAt      DateTime?
  finishedAt     DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id])
  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowRunId])
  @@index([organizationId, workflowRunId])
  @@map("workflow_step_runs")
}
