# Generate both values locally; do not commit real secrets.
VITO_WORKER_TOKEN=replace-with-random-hex
N8N_ENCRYPTION_KEY=replace-with-random-hex

# Optional worker tuning
VITO_WORKER_PORT=8081
VITO_WORKER_DEFAULT_TIMEOUT_MS=120000
VITO_WORKER_MAX_OUTPUT_BYTES=1000000

