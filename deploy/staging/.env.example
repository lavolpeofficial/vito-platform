# Copy to deploy/staging/.env on the authorized runtime host.
# Never commit the real values.

# Generate independently with a cryptographically secure generator.
VITO_STAGING_DB_PASSWORD=replace-with-long-random-database-password
VITO_STAGING_JWT_SECRET=replace-with-at-least-32-random-bytes

# Cloud coding execution remains fail-closed by default.
# Keep the profile disabled until a human has authorized the OpenAI credential.
VITO_CLOUD_PROFILE_ENABLED=false
VITO_CLOUD_AGENT_CREDENTIALS_JSON={}

# OpenCode >=2.0.3 stores ChatGPT/Codex OAuth in opencode.db.
# /dev/null keeps staging fail-closed until a human-authorized DB is installed.
VITO_CLOUD_OPENCODE_DB_PATH=/dev/null
