#!/bin/sh
set -eu
BIN=/opt/vito/trusted-launchers/opencode-runtime/node_modules/.bin/opencode
EVIDENCE=/opt/vito/trusted-launchers/opencode-sqlite-identity-evidence.mjs
if [ "${1:-}" != "run" ]; then exec "$BIN" "$@"; fi
: "${XDG_CONFIG_HOME:?XDG_CONFIG_HOME required}"
: "${XDG_DATA_HOME:?XDG_DATA_HOME required}"

AUTH_FILE="$XDG_DATA_HOME/opencode/auth.json"
[ -f "$AUTH_FILE" ] || exit 55
OPENAI_API_KEY="$(
  node -e '
    const fs=require("fs");
    let value="";
    try {
      const parsed=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
      value=parsed && typeof parsed.apiKey === "string" ? parsed.apiKey.trim() : "";
    } catch { process.exit(55); }
    if (!value || value.length > 4096 || /[\r\n\0]/.test(value)) process.exit(55);
    process.stdout.write(value);
  ' "$AUTH_FILE"
)" || exit 55
[ -n "$OPENAI_API_KEY" ] || exit 55
export OPENAI_API_KEY
rm -f "$AUTH_FILE"

mkdir -p "$XDG_CONFIG_HOME/opencode"
node -e '
const fs=require("fs");
const p=process.argv[1];
const h=process.env.HOME;
const isTest=process.env.CAPABILITY_CODE==="TEST_EXECUTION";
const config=isTest ? {
  model:"openai/gpt-5.6-sol",
  default_agent:"build",
  permissions:[
    {action:"read",resource:"*",effect:"allow"},
    {action:"read",resource:"*.env",effect:"deny"},
    {action:"read",resource:"*.env.*",effect:"deny"},
    {action:"glob",resource:"*",effect:"allow"},
    {action:"grep",resource:"*",effect:"allow"},
    {action:"edit",resource:"*",effect:"deny"},
    {action:"edit",resource:"docs/vito-flight-001-proof.md",effect:"allow"},
    {action:"shell",resource:"*",effect:"deny"},
    {action:"shell",resource:"git status",effect:"allow"},
    {action:"shell",resource:"git status *",effect:"allow"},
    {action:"shell",resource:"git diff",effect:"allow"},
    {action:"shell",resource:"git diff *",effect:"allow"},
    {action:"shell",resource:"git show",effect:"allow"},
    {action:"shell",resource:"git show *",effect:"allow"},
    {action:"shell",resource:"git log",effect:"allow"},
    {action:"shell",resource:"git log *",effect:"allow"},
    {action:"shell",resource:"git rev-parse *",effect:"allow"},
    {action:"shell",resource:"git branch --show-current",effect:"allow"},
    {action:"shell",resource:"pnpm test",effect:"allow"},
    {action:"shell",resource:"pnpm test *",effect:"allow"},
    {action:"subagent",resource:"*",effect:"deny"},
    {action:"webfetch",resource:"*",effect:"deny"},
    {action:"websearch",resource:"*",effect:"deny"},
    {action:"external_directory",resource:"*",effect:"deny"},
    {action:"external_directory",resource:h+"/.local/share/opencode/snapshot/*",effect:"allow"},
    {action:"external_directory",resource:h+"/.cache/opencode/bin/*",effect:"allow"}
  ]
} : {
  model:"openai/gpt-5.6-sol",
  permission:{external_directory:{
    "*":"deny",
    [h+"/.local/share/opencode/snapshot/**"]:"allow",
    [h+"/.cache/opencode/bin/**"]:"allow"
  }}
};
fs.writeFileSync(p,JSON.stringify(config));
' "$XDG_CONFIG_HOME/opencode/opencode.json"
set +e
"$BIN" "$@"
rc=$?
DB="$XDG_DATA_HOME/opencode/opencode.db"
evidence_rc=54
if [ -f "$DB" ]; then
  node --no-warnings=ExperimentalWarning --experimental-sqlite "$EVIDENCE" "$DB"
  evidence_rc=$?
fi
set -e
unset OPENAI_API_KEY
if [ "$rc" -ne 0 ]; then exit "$rc"; fi
[ "$evidence_rc" -eq 0 ] || exit "$evidence_rc"
exit 0
