DATABASE_URL=postgresql://vito:vito@localhost:5432/vito
PORT=3000

# --- Authentifizierung (Sprint 2) -------------------------------------

# Pflicht. Geheimer Schlüssel zum Signieren/Verifizieren von JWTs. Die
# Anwendung startet NICHT, wenn diese Variable fehlt. Für echte
# Umgebungen einen langen, zufälligen Wert generieren, z. B.:
#   openssl rand -base64 48
JWT_SECRET=please-change-me-to-a-long-random-value

# Optional. Gültigkeitsdauer ausgestellter JWTs (jsonwebtoken-Format).
# Default seit Sprint 2.1: 15m (bewusst kurz gehalten, siehe ADR-003
# "JWT Lifetime" und "Warum keine Refresh Tokens").
JWT_EXPIRES_IN=15m

# Optional, NUR für lokale Entwicklung. Erlaubt den ungeprüften
# X-Organization-Id-Header als Fallback, wenn KEIN Authorization-Header
# vorhanden ist (siehe README "Security Warning" und ADR-003).
# Default: false. Die Anwendung verweigert den Start, wenn dieses Flag
# zusammen mit NODE_ENV=production gesetzt ist.
ALLOW_INSECURE_TENANT_HEADER=false

# Optional. Steuert die Umgebung (u. a. für Swagger-, CORS- und
# Insecure-Header-Gating-Logik). In Produktionsumgebungen unbedingt auf
# "production" setzen.
NODE_ENV=development

# Optional. Swagger (/api/docs) ist standardmäßig aktiv, außer wenn
# NODE_ENV=production gesetzt ist. Mit ENABLE_SWAGGER=true kann Swagger
# explizit auch dann aktiviert werden (z. B. abgesichertes Staging).
ENABLE_SWAGGER=true

# --- Sicherheits-Hardening (Sprint 2.1) --------------------------------

# Optional, nur relevant wenn NODE_ENV=production. Kommagetrennte Liste
# erlaubter CORS-Origins, z. B.:
#   CORS_ALLOWED_ORIGINS=https://app.vito.example,https://admin.vito.example
# In Produktion NIEMALS "*" verwenden. Ist die Liste leer, werden
# Cross-Origin-Requests in Produktion vollständig blockiert (sicherer
# Default statt versehentlich offener Policy). In Development (Default)
# ist CORS permissiv, unabhängig von dieser Variable.
CORS_ALLOWED_ORIGINS=

# Optional. Rate-Limiting AUSSCHLIESSLICH für POST /auth/login (keine
# globale Drosselung anderer Endpunkte). Default: 5 Requests pro Minute
# pro IP.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- SOURCE VAULT / Object Storage ------------------------------------
# Provider-neutraler S3-kompatibler Vertrag. Noch kein Provider ist fest
# verdrahtet. Secrets niemals committen; echte Werte gehören in Secret
# Management / Deployment-Konfiguration.
SOURCE_VAULT_S3_ENDPOINT=
SOURCE_VAULT_S3_REGION=
SOURCE_VAULT_S3_BUCKET=
SOURCE_VAULT_S3_ACCESS_KEY_ID=
SOURCE_VAULT_S3_SECRET_ACCESS_KEY=
SOURCE_VAULT_S3_FORCE_PATH_STYLE=false

# --- Seed (optional) ---------------------------------------------------

# Zugangsdaten für den initialen Owner-User von ATERIMA, der durch
# `pnpm prisma:seed` angelegt wird. Niemals hart codieren — ohne diese
# beiden Variablen (oder bei einem Passwort < 12 Zeichen) wird kein
# Owner-User angelegt und der Seed läuft mit einer Warnung ohne Login-
# Möglichkeit durch.
SEED_OWNER_EMAIL=owner@aterima.io
SEED_OWNER_PASSWORD=change-me-to-a-strong-password
