DATABASE_URL=postgresql://vito:vito@localhost:5432/vito
PORT=3000

# --- Authentifizierung (Sprint 2) -------------------------------------
JWT_SECRET=please-change-me-to-a-long-random-value
JWT_EXPIRES_IN=15m
ALLOW_INSECURE_TENANT_HEADER=false
NODE_ENV=development
ENABLE_SWAGGER=true

# --- Sicherheits-Hardening (Sprint 2.1) ------------------------------
CORS_ALLOWED_ORIGINS=
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- SOURCE VAULT -----------------------------------------------------
# Development: local. Production: must be explicitly set to s3.
SOURCE_VAULT_STORAGE_DRIVER=local
SOURCE_VAULT_LOCAL_DIR=.source-vault
SOURCE_VAULT_MAX_UPLOAD_BYTES=26214400

# Generic S3-compatible adapter (AWS SigV4; suitable for providers such as
# Hetzner Object Storage when configured with its location endpoint/region).
SOURCE_VAULT_S3_ENDPOINT=https://fsn1.your-objectstorage.com
SOURCE_VAULT_S3_REGION=fsn1
SOURCE_VAULT_S3_BUCKET=
SOURCE_VAULT_S3_ACCESS_KEY_ID=
SOURCE_VAULT_S3_SECRET_ACCESS_KEY=

# --- Seed (optional) --------------------------------------------------
SEED_OWNER_EMAIL=owner@aterima.io
SEED_OWNER_PASSWORD=change-me-to-a-strong-password
