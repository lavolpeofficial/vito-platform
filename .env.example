DATABASE_URL=postgresql://vito:vito@localhost:5432/vito
PORT=3000

# --- Authentifizierung (Sprint 2) -------------------------------------
JWT_SECRET=please-change-me-to-a-long-random-value
JWT_EXPIRES_IN=15m
ALLOW_INSECURE_TENANT_HEADER=false
NODE_ENV=development
ENABLE_SWAGGER=true

# --- Sicherheits-Hardening (Sprint 2.1) ------------------------------
CORS_ALLOWED_ORIGINS=
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- SOURCE VAULT -----------------------------------------------------
# Development: local. Production: must be explicitly set to s3.
SOURCE_VAULT_STORAGE_DRIVER=local
SOURCE_VAULT_LOCAL_DIR=.source-vault
SOURCE_VAULT_MAX_UPLOAD_BYTES=26214400

# Generic S3-compatible adapter (AWS SigV4; suitable for providers such as
# Hetzner Object Storage when configured with its location endpoint/region).
SOURCE_VAULT_S3_ENDPOINT=https://fsn1.your-objectstorage.com
SOURCE_VAULT_S3_REGION=fsn1
SOURCE_VAULT_S3_BUCKET=
SOURCE_VAULT_S3_ACCESS_KEY_ID=
SOURCE_VAULT_S3_SECRET_ACCESS_KEY=

# --- Seed (optional) --------------------------------------------------
SEED_OWNER_EMAIL=owner@aterima.io
SEED_OWNER_PASSWORD=change-me-to-a-strong-password

# --- Governed Runtime (B2c) -------------------------------------------
# Serverseitiger, absoluter Workspace-Root der governed Runtime. Pflicht:
# fehlt der Wert oder ist er nicht absolut, schlägt der Start der API
# fehl (fail closed). Es gibt bewusst KEINE Fallbacks (cwd/$HOME/tmp).
GOVERNED_WORKSPACE_ROOT=

# --- Operator Bridge v0.1 ---------------------------------------------
# Application deployment mode only: this does not make the route network-private.
# Infrastructure must enforce network isolation. Public remains blocked until
# payload cleanup and approved ingress/network controls are deployed and verified.
OPERATOR_BRIDGE_EXPOSURE=internal
SENSITIVE_PAYLOAD_TTL_HOURS=72

# --- Server-owned credential references ------------------------------
# JSON map of opaque credential reference -> secret. Values are server-side only,
# never accepted from command clients and never emitted in audit/result payloads.
# Store the real value in the deployment secret manager/environment, not in git.
VITO_SERVER_CREDENTIALS={}

# --- JARVIS / WORLD governed command adapter --------------------------
# WORLD.RUN_GATE dispatches ONLY the fixed WORLD governed-gate workflow and only
# when the requested gate exactly matches WORLD's own ci/world-remote-gate.json.
# WORLD only knows the opaque credential reference below; the actual GitHub token
# lives in VITO_SERVER_CREDENTIALS and must have minimum required repository rights.
WORLD_REPOSITORY=lavolpeofficial/aoe-knowledge-engine
WORLD_BRANCH=case/global-resilience-harvest-v0.1-agent
WORLD_GATE_WORKFLOW=world-remote-gate.yml
WORLD_GITHUB_CREDENTIAL_REF=github.world.actions

# --- Governed Runtime — Trusted Execution (OB-002A real CODE_BUILD flow) ---
# Required ONLY for real deep local-agent executions (LOCAL_TOOL providers);
# pure policy/sandbox unit tests do not need them. Omit/empty => fail closed.
# Exact repository registry JSON array: each entry needs repositoryId, cloneUrl,
# a non-empty allowedBaseRefs string array (no wildcards), and enabled.
VITO_REPOSITORY_REGISTRY=[{"repositoryId":"lavolpeofficial/vito-platform","cloneUrl":"https://github.com/lavolpeofficial/vito-platform.git","allowedBaseRefs":["main"],"enabled":true}]
# Trusted local executable registry JSON: alias -> ABSOLUTE launcher path on the
# host. Paths must resolve inside VITO_TRUSTED_AGENT_LAUNCHER_ROOT; the resolver
# rejects relative paths, PATH lookups, and non-executable targets. Only these
# exact aliases can ever be authorized as coding-agent launchers.
VITO_TRUSTED_LOCAL_EXECUTABLES={"opencode":"/opt/vito/trusted-launchers/opencode","codex":"/opt/vito/trusted-launchers/codex"}
# Working directory that hosts the trusted local agent launchers (fallback for
# relative command resolution); must be absolute and read-only for non-operators.
VITO_TRUSTED_AGENT_LAUNCHER_ROOT=/opt/vito/trusted-launchers
# Sandbox technology. bubblewrap is the only production-supported option;
# "none" is never permitted in production (downgrade denied, fail closed).
VITO_SANDBOX_TECHNOLOGY=bubblewrap
